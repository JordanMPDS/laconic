{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "env LACONIC_JSON_PATH=additional_context bash /absolute/path/to/laconic/hooks/laconic.sh start",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "type": "command",
        "command": "bash /absolute/path/to/laconic/hooks/laconic.sh switch",
        "timeout": 5,
        "failClosed": false
      }
    ]
  }
}
