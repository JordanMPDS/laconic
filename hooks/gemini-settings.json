{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "laconic",
            "type": "command",
            "command": "env LACONIC_JSON_PATH=hookSpecificOutput.additionalContext bash /absolute/path/to/laconic/hooks/laconic.sh start",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "laconic",
            "type": "command",
            "command": "env LACONIC_JSON_PATH=hookSpecificOutput.additionalContext bash /absolute/path/to/laconic/hooks/laconic.sh remind",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
