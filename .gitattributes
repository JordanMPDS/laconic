# Git for Windows defaults to core.autocrlf=true and the marketplace installs by
# cloning, so these must be pinned: a CRLF laconic.sh exits 2 under bash and a
# CRLF rules file defeats the slicer (#424). Scoped by pattern rather than
# `* text=auto`, which would renormalise the CRLF events.csv fixtures that sit
# inside cases_cksum.
*.sh text eol=lf
*.md text eol=lf
